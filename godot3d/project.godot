[application]
config/name="Ascension: Earthfront 3D"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[rendering]
anti_aliasing/quality/msaa_3d=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)

[input]
camera_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194319)]}
camera_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194321)]}
camera_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194320)]}
camera_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194322)]}
camera_rotate_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":90)]}
camera_rotate_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}

